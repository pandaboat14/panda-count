# Neon Postgres. The Vercel ↔ Neon integration sets this for you;
# locally, copy it with `vercel env pull .env.local`.
DATABASE_URL=

# Neon Auth. Copy the Auth URL from Neon Console → your project → Auth.
NEON_AUTH_BASE_URL=
# Any random string of 32+ characters, e.g. `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
